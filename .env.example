# Server-side only. This file is a template, never a place for real keys in Git.
# Fixed per-function routing: Groq + Gemini only; no local models or fallback.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-4-hydrogen
GEMINI_DEEP_MODEL=gemini-4-hydrogen
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
VERA_AI_TIMEOUT_MS=45000
VERA_DAILY_LIMIT=30
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
VERA_DB=vera.sqlite
VERA_OWNER_EMAIL=
VERA_OWNER_PASSWORD=
# Keep legacy public password hashes disabled. Use server environment credentials.
VERA_ALLOW_LEGACY_OWNER_FILE=false
VERA_ORIGINS=capacitor://localhost,https://localhost
HOST=127.0.0.1
PORT=8080
